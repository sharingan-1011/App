# URL of your llama-server (Cloudflare tunnel or localhost)
FORGE_BASE_URL=https://your-tunnel.trycloudflare.com

# llama-server api key (use anything if --api-key not set)
FORGE_API_KEY=sk-no-key

# Model name reported by /v1/models (can be anything, model is set by server)
FORGE_MODEL_NAME=local-model

# SQLite database path
FORGE_DB_PATH=forge.db

# Unused in Phase 2 (kept for compat)
FORGE_THINKING_BUDGET=8192

# ── security hardening ──────────────────────────────────────────────
# Bind address/port for forge_run.py. Default is loopback-only; set to
# 0.0.0.0 to expose on the LAN (only do this if you also set
# FORGE_API_AUTH_KEY below).
FORGE_BIND_HOST=127.0.0.1
FORGE_BIND_PORT=8000

# uvicorn --reload. Off by default: a restart silently drops in-flight
# approvals/cancellation state. Set true only for local development.
FORGE_DEV_RELOAD=false

# Comma-separated list of allowed CORS origins for app.html.
FORGE_CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,null

# If set, every API request must carry a matching "X-Forge-Key" header.
# Empty (default) means no auth — fine for a strictly local, trusted
# single-operator setup only.
FORGE_API_AUTH_KEY=

# If set, confines fs_read/fs_write/fs_list/fs_delete (and shell_exec's
# cwd) to this directory tree. Empty (default) preserves unrestricted
# filesystem access within the process's own OS permissions.
FORGE_FS_WORKSPACE_ROOT=
